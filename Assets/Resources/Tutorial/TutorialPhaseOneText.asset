  m_Script: {fileID: 11500000, guid: 699db8b9b9dcceb48a9a0dd18183fbef, type: 3}
  m_Name: TutorialPhaseOneText
  m_EditorClassIdentifier: 
  moveTitle: "DI CHUY\u1EC2N"
  moveBrief: "D\xF9ng [W] [A] [S] [D] \u0111\u1EC3 di chuy\u1EC3n.\n\nCh\xE0o m\u1EEBng
    b\u1EA1n \u0111\u1EBFn v\u1EDBi nh\u1EADt k\xFD sinh t\u1ED3n. Khu v\u1EF1c n\xE0y
    hi\u1EC7n an to\xE0n. H\xE3y l\xE0m quen v\u1EDBi c\u1EA3m gi\xE1c \u0111i\u1EC1u
    khi\u1EC3n tr\u01B0\u1EDBc khi \u0111i ti\u1EBFp.\n\n[Chu\u1ED9t tr\xE1i] B\u1EAFt
    \u0111\u1EA7u"
  moveObjective: "DI CHUY\u1EC2N"
  zoomTitle: "T\u1EA6M NH\xCCN"
  zoomBrief: "L\u0103n con l\u0103n chu\u1ED9t \u0111\u1EC3 thay \u0111\u1ED5i kho\u1EA3ng
    c\xE1ch quan s\xE1t.\n\nT\u1EA7m nh\xECn r\u1ED9ng gi\xFAp b\u1EA1n \u0111\u1ECDc
    t\xECnh hu\u1ED1ng t\u1ED1t h\u01A1n; zoom g\u1EA7n gi\xFAp ch\xFA \xFD chi ti\u1EBFt.\n\n[Chu\u1ED9t
    tr\xE1i] Th\u1EED ngay"
  zoomObjective: "L\u0102N CHU\u1ED8T \u0110\u1EC2 ZOOM IN / OUT"
  aimTitle: "QUAN S\xC1T"
  aimBrief: "Gi\u1EEF [Chu\u1ED9t ph\u1EA3i] v\xE0 h\u01B0\u1EDBng con tr\u1ECF t\u1EDBi
    n\u01A1i b\u1EA1n mu\u1ED1n quan s\xE1t.\n\nT\u1EA7m nh\xECn l\xE0 y\u1EBFu t\u1ED1
    quy\u1EBFt \u0111\u1ECBnh \u0111\u1EBFn s\u1EF1 an to\xE0n c\u1EE7a b\u1EA1n,
    h\xE3y quan s\xE1t th\u1EADt c\u1EA9n th\u1EADn!\n\n[Chu\u1ED9t tr\xE1i] Ti\u1EBFp
    t\u1EE5c"
  aimObjective: "GI\u1EEE CHU\u1ED8T PH\u1EA2I V\xC0 QUAN S\xC1T XUNG QUANH"
  needsTitle: "TH\u1EC2 TR\u1EA0NG"
  needsBrief: "C\xE1c bi\u1EC3u t\u01B0\u1EE3ng g\u1ED1c ph\u1EA3i s\u1EBD ph\u1EA3n
    \xE1nh t\xECnh tr\u1EA1ng c\u1EE7a c\u01A1 th\u1EC3.\n\nM\xE0u xanh v\xE0 hi\u1EC7u
    \u1EE9ng c\xF3 l\u1EE3i, m\xE0u \u0111\u1ECF l\xE0 b\u1EA5t l\u1EE3i\n\n[Chu\u1ED9t
    tr\xE1i] Ti\u1EBFp t\u1EE5c"
  needsFocusTitle: "\u0110\xD3I V\xC0 KH\xC1T"
  needsFocusBody: "Hai bi\u1EC3u t\u01B0\u1EE3ng n\xE0y cho bi\u1EBFt th\u1EC3 tr\u1EA1ng
    hi\u1EC7n t\u1EA1i c\u1EE7a b\u1EA1n.\nB\u1EA1n \u0111ang \u0111\xF3i v\xE0 kh\xE1t,
    h\xE3y c\xE2n b\u1EB1ng ch\u1EC9 s\u1ED1 c\u01A1 th\u1EC3 \u0111\u1EC3 sinh t\u1ED3n\n\n[Chu\u1ED9t
    tr\xE1i] Ti\u1EBFp t\u1EE5c"
  houseTitle: "T\xCCM G\xCC \u0110\xD3 XUNG QUANH"
  houseBrief: "\u0110i v\xE0o c\u0103n nh\xE0 g\u1EA7n nh\u1EA5t theo \u0111i\u1EC3m
    \u0111\xE1nh d\u1EA5u v\xE0ng \u0111\u1EC3 t\xECm \u0111\u1ED3.\n\n[Chu\u1ED9t
    tr\xE1i] Ti\u1EBFp t\u1EE5c"
  houseObjective: "\u0110I V\xC0O NH\xC0 THEO \u0110I\u1EC2M \u0110\xC1NH D\u1EA4U
    V\xC0NG"
  houseMarker: "V\xC0O NH\xC0"
  cabinetTitle: "L\u1EE4C SO\xC1T"
  cabinetBrief: "\u0110\xE2y l\xE0 t\u1EE7 b\u1EBFp \u0111\u01B0\u1EE3c \u0111\xE1nh
    d\u1EA5u. \u0110\u1EBFn g\u1EA7n v\xE0 nh\u1EA5p v\xE0o n\xF3 \u0111\u1EC3 m\u1EDF
    kho \u0111\u1ED3.\n\nL\u1EA5y to\xE0n b\u1ED9 v\u1EADt d\u1EE5ng b\xEAn trong
    tr\u01B0\u1EDBc khi r\u1EDDi \u0111i, k\u1EC3 c\u1EA3 kh\u1EA9u S12K.\n\n[Chu\u1ED9t
    tr\xE1i] M\u1EDF t\u1EE7"
  lootObjective: "L\u1EA4Y TO\xC0N B\u1ED8 \u0110\u1ED2 TRONG T\u1EE6"
  cabinetMarker: "T\u1EE6 B\u1EBEP"
  consumeTitle: "D\xD9NG \u0110\u1ED2 TI\u1EBEP T\u1EBE"
  consumeBrief: "M\u1EDF t\xFAi \u0111\u1ED3 b\u1EB1ng [TAB] ho\u1EB7c [I].\n\nD\xF9ng
    th\u1ECBt v\xE0 n\u01B0\u1EDBc u\u1ED1ng \u0111\u1EC3 h\u1ED3i l\u1EA1i hai ch\u1EC9
    s\u1ED1 v\u1EEBa h\u1ECDc.\n\n[Chu\u1ED9t tr\xE1i] Ti\u1EBFp t\u1EE5c"
  consumeObjective: "D\xD9NG TH\u1ECAT V\xC0 N\u01AF\u1EDAC U\u1ED0NG TRONG T\xDAI
    \u0110\u1ED2"
  weaponTitle: "TRANG B\u1ECB V\u0168 KH\xCD"
  weaponBrief: "M\u1EDF t\xFAi \u0111\u1ED3 b\u1EB1ng [TAB] ho\u1EB7c [I], r\u1ED3i
    k\xE9o kh\u1EA9u S12K v\xE0o m\u1ED9t trong n\u0103m \xF4 Hotbar ph\xEDa d\u01B0\u1EDBi.\n\n[Chu\u1ED9t
    tr\xE1i] Ti\u1EBFp t\u1EE5c"
  weaponObjective: "K\xC9O S12K V\xC0O M\u1ED8T \xD4 HOTBAR"
  reloadTitle: "N\u1EA0P \u0110\u1EA0N"
  reloadBrief: "Kh\u1EA9u S12K \u0111ang tr\u1ED1ng \u0111\u1EA1n. \u0110\xF3ng t\xFAi
    \u0111\u1ED3, ch\u1ECDn kh\u1EA9u s\xFAng tr\xEAn Hotbar r\u1ED3i nh\u1EA5n [R] \u0111\u1EC3
    n\u1EA1p \u0111\u1EA1n.\n\n[Chu\u1ED9t tr\xE1i] Ti\u1EBFp t\u1EE5c"
  reloadObjective: "NH\u1EA4N [R] \u0110\u1EC2 N\u1EA0P \u0110\u1EA0N CHO S12K"
  leaveHouseTitle: "C\xD3 G\xCC \u0110\xD3 B\xCAN NGO\xC0I"
  leaveHouseBrief: "B\u1EA1n \u0111\xE3 c\xF3 \u0111\u1ED3 ti\u1EBFp t\u1EBF v\xE0 m\u1ED9t
    kh\u1EA9u s\xFAng \u0111\xE3 n\u1EA1p \u0111\u1EA1n.\n\nRa kh\u1ECFi c\u0103n nh\xE0 th\u1EADt
    c\u1EA9n th\u1EADn.\n\n[Chu\u1ED9t tr\xE1i] Ti\u1EBFp t\u1EE5c"
  leaveHouseObjective: "R\u1EDCI KH\u1ECEI C\u0102N NH\xC0"
  noiseTitle: "TI\u1EBENG \u1ED2N"
  noiseBrief: "B\u01B0\u1EDBc ch\xE2n, ch\u1EA1y, c\u1EADn chi\u1EBFn v\xE0 s\xFAng n\u1ED5
    \u0111\u1EC1u c\xF3 th\u1EC3 k\xE9o zombie t\u1EDBi. H\xE3y \u0111\u1EC3 \xFD thanh \u0110\u1ED9
    \u1ED3n \u1EDF g\xF3c d\u01B0\u1EDBi b\xEAn tr\xE1i.\n\n[Chu\u1ED9t tr\xE1i] Ti\u1EBFp t\u1EE5c"
  noiseObjective: "THEO D\xD5I THANH \u0110\u1ED8 \u1ED2N"
  sneakTitle: "TI\u1EBEP C\u1EACN \xC2M TH\u1EA6M"
  sneakBrief: "Nh\u1EA5n [C] \u0111\u1EC3 ng\u1ED3i xu\u1ED1ng, r\u1ED3i ti\u1EBFp c\u1EADn
    zombie t\u1EEB ph\xEDa sau.\n\n[Chu\u1ED9t tr\xE1i] Ti\u1EBFp t\u1EE5c"
  sneakObjective: "NH\u1EA4N [C] V\xC0 TI\u1EBEP C\u1EACN ZOMBIE T\u1EEA PH\xCDA SAU"
  meleeTitle: "\u0110\xC1NH TH\u01AF\u1EDCNG"
  meleeBrief: "Gi\u1EEF [Chu\u1ED9t ph\u1EA3i] \u0111\u1EC3 ng\u1EAFm h\u01B0\u1EDBng ra \u0111\xF2n
    v\xE0 nh\u1EA5n [Space] \u0111\u1EC3 \u0111\xE1nh b\u1EB1ng b\xE1ng s\xFAng.\n\n[Chu\u1ED9t
    tr\xE1i] Ti\u1EBFp t\u1EE5c"
  meleeObjective: "GI\u1EEE [CHU\u1ED8T PH\u1EA2I] + NH\u1EA4N [SPACE] \u0110\u1EC2 H\u1EA0 ZOMBIE"
  completeTitle: "GIAI \u0110O\u1EA0N HI\u1EC6N T\u1EA0I HO\xC0N TH\xC0NH"
  completeBrief: "B\u1EA1n \u0111\xE3 bi\u1EBFt c\xE1ch ti\u1EBFp t\u1EBF, chu\u1EA9n b\u1ECB
    v\u0169 kh\xED, ki\u1EC3m so\xE1t ti\u1EBFng \u1ED3n v\xE0 ti\u1EBFp c\u1EADn zombie t\u1EEB
    ph\xEDa sau.\n\nB\xE0i h\u1ECDc b\u1EAFn s\xFAng s\u1EBD ti\u1EBFp t\u1EE5c \u1EDF b\u01B0\u1EDBc
    k\u1EBF ti\u1EBFp.\n\n[Chu\u1ED9t tr\xE1i] Ti\u1EBFp t\u1EE5c"
