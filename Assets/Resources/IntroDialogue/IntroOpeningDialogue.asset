  m_Script: {fileID: 11500000, guid: e3affbaaec2887d46abab43c449ef687, type: 3}
  m_Name: IntroOpeningDialogue
  m_EditorClassIdentifier: 
  lines:
  - "\u1EE6a, xe m\xECnh b\u1ECB sao v\u1EADy n\xE8?"
  - "Kh\xF4ng l\u1EBD l\xE0 h\u1EBFt x\u0103ng?"
  - "Nh\u01B0ng v\xF4 l\xFD qu\xE1, m\xECnh v\u1EEBa m\u1EDBi \u0111\u1ED5 x\u0103ng
    tr\u01B0\u1EDBc khi ch\u1EA1y t\u1EDBi \u0111\xE2y m\xE0?"
  - "Ch\u1EAFc l\xE0 ph\u1EA3i xu\u1ED1ng xe ki\u1EC3m tra th\xF4i."
